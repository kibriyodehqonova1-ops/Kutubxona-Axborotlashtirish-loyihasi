    <style>
        /* Kategoriya filtri ro'yxatidagi rasmlarni bir xil o'lchamga keltirish */
#category-filter .category-list li figure {
    width: 100%;
    height: 320px;          /* Istalgan balandlik */
    overflow: hidden;
    position: relative;
}

#category-filter .category-list li figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;      /* Rasmni butunlay qoplaydi, nisbatni saqlaydi */
    object-position: center; /* Markazga joylashtiradi */
    transition: transform 0.3s ease;
}

/* Ixtiyoriy: hover effekti */
#category-filter .category-list li figure:hover img {
    transform: scale(1.05);
}

       
            /* Rasmlarni bir xil o‘lchamda va chiroyli ko‘rsatish */
            .booksmedia-fullwidth ul li figure {
                width: 100%;
                height: 280px;
                overflow: hidden;
                position: relative;
            }

            .book-thumbnail {
                width: 100%;
                height: 100%;
                object-fit: cover;
                object-position: center;
                transition: transform 0.3s ease;
            }

            .booksmedia-fullwidth ul li figure:hover .book-thumbnail {
                transform: scale(1.05);
            }
            /* Qo‘shimcha: agar rasm yuklanmasa, fon rangi */
            .book-thumbnail {
                background-color: #f5f5f5;
            }
     
    </style>
