@using static KutubxonaAt.Models.Kitob
@model KutubxonaAt.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Kutubxona bosh sahifasi";
}

<!-- Slider (o‘zgarishsiz) -->
<div data-ride="carousel" class="carousel slide" id="home-v1-header-carousel">
    <div class="carousel-inner">
        <div class="item active">
            <figure><img alt="Kutubxona" src="~/images/header-slider/home-v1/header-slide.jpg" /></figure>
            <div class="container">
                <div class="carousel-caption">
                    <h3>Kutubxonamizga xush kelibsiz!</h3>
                    <h2>Kitoblar olamiga sayohat</h2>
                    <p>Kutubxonamizda 50 000 dan ortiq kitoblar, elektron resurslar va multimediya materiallari mavjud. Barcha yoshdagi kitobxonlar uchun mo‘ljallangan.</p>
                    <div class="slide-buttons hidden-sm hidden-xs">
                        <a href="#" class="btn btn-primary">Batafsil</a>
                        <a href="#" class="btn btn-default">Kitob izlash</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="item">
            <figure><img alt="Kutubxona" src="~/images/header-slider/home-v1/header-slide.jpg" /></figure>
            <div class="container">
                <div class="carousel-caption">
                    <h3>Elektron kutubxona</h3>
                    <h2>10 000+ elektron kitoblar</h2>
                    <p>Istagan joydan turib o‘qishingiz mumkin. Barcha elektron kitoblar bepul. Ro‘yxatdan o‘ting va zavqlaning.</p>
                    <div class="slide-buttons hidden-sm hidden-xs">
                        <a href="#" class="btn btn-primary">Ro‘yxatdan o‘tish</a>
                        <a href="#" class="btn btn-default">Elektron kitoblar</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="item">
            <figure><img alt="Kutubxona" src="~/images/header-slider/home-v1/header-slide.jpg" /></figure>
            <div class="container">
                <div class="carousel-caption">
                    <h3>Bolalar va o‘smirlar uchun</h3>
                    <h2>Maxsus to‘plamlar</h2>
                    <p>Bolalar adabiyoti, ertaklar, sarguzasht romanlar va boshqa ko‘plab kitoblar maxsus bo‘limda.</p>
                    <div class="slide-buttons hidden-sm hidden-xs">
                        <a href="#" class="btn btn-primary">Batafsil</a>
                        <a href="#" class="btn btn-default">Bolalar bo‘limi</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <a class="left carousel-control" href="#home-v1-header-carousel" data-slide="prev"></a>
    <a class="right carousel-control" href="#home-v1-header-carousel" data-slide="next"></a>
</div>

<!-- Search Section -->
<section class="search-filters">
    <div class="container">
        <div class="filter-box">
            <h3>Kutubxonadan nimani qidiryapsiz?</h3>
            <form asp-controller="Home" asp-action="Index" method="get">
                <div class="col-md-4 col-sm-6">
                    <div class="form-group">
                        <input class="form-control" placeholder="Kalit so‘z bo‘yicha qidirish" id="keywords" name="keywords" type="text" value="@ViewBag.Keywords">
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="form-group">
                        <select name="catalogId" id="catalog" class="form-control">
                            <option value="">Katalogni tanlang</option>
                            <option value="1" selected="@(ViewBag.SelectedCatalog == "1")">Asosiy fond (Kitoblar)</option>
                            <option value="2" selected="@(ViewBag.SelectedCatalog == "2")">Elektron fond</option>
                            <option value="3" selected="@(ViewBag.SelectedCatalog == "3")">Audio kitoblar</option>
                            <option value="4" selected="@(ViewBag.SelectedCatalog == "4")">Jurnallar</option>
                            <option value="5" selected="@(ViewBag.SelectedCatalog == "5")">Video materiallar</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="form-group">
                        <select name="categoryId" id="category" class="form-control">
                            <option value="">Barcha kategoriyalar</option>
                            @foreach (var cat in ViewBag.Categories)
                            {
                                <option value="@cat.Id" selected="@(ViewBag.SelectedCategoryId == cat.Id)">@cat.Nomi</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-2 col-sm-6">
                    <div class="form-group">
                        <input class="form-control" type="submit" value="Qidirish">
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>

@if (!Model.IsSearch)
{
    <!-- Welcome Section -->
    <section class="welcome-section">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <div class="welcome-wrap">
                        <div class="welcome-text">
                            <h2 class="section-title">Kutubxonamizga xush kelibsiz!</h2>
                            <span class="underline left"></span>
                            <p class="lead">@Model.LeadText</p>
                            <p>@Model.WelcomeText</p>
                            <a class="btn btn-primary" href="#">Batafsil</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="facts-counter">
                        <ul>
                            <li class="bg-light-green"><div class="fact-item"><div class="fact-icon"><i class="ebook"></i></div><span>Elektron kitoblar<strong class="fact-counter">@Model.EBookCount</strong></span></div></li>
                            <li class="bg-green"><div class="fact-item"><div class="fact-icon"><i class="eaudio"></i></div><span>Audio kitoblar<strong class="fact-counter">@Model.AudioBookCount</strong></span></div></li>
                            <li class="bg-red"><div class="fact-item"><div class="fact-icon"><i class="magazine"></i></div><span>Jurnallar<strong class="fact-counter">@Model.JournalCount</strong></span></div></li>
                            <li class="bg-blue"><div class="fact-item"><div class="fact-icon"><i class="videos"></i></div><span>Video materiallar<strong class="fact-counter">@Model.VideoCount</strong></span></div></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="welcome-image"></div>
    </section>

    <!-- Yangi kelgan kitoblar -->
    <section class="category-filter section-padding">
        <div class="container">
            <div class="center-content">
                <h2 class="section-title">Yangi kelgan kitoblar</h2>
                <span class="underline center"></span>
                <p class="lead">Eng so‘nggi nashrlar va yangi adabiyotlar bilan tanishing.</p>
            </div>
            <div class="filter-buttons">
                <div class="filter btn" data-filter="all">Barchasi</div>
                <div class="filter btn" data-filter=".adults">Badiiy</div>
                <div class="filter btn" data-filter=".kids-teens">Bolalar</div>
                <div class="filter btn" data-filter=".video">Video</div>
                <div class="filter btn" data-filter=".audio">Audio</div>
                <div class="filter btn" data-filter=".books">Ilmiy</div>
                <div class="filter btn" data-filter=".magazines">Jurnallar</div>
            </div>
        </div>
        <div id="category-filter">
            <ul class="category-list">
                @foreach (var book in Model.RecentBooks)
                {
                    <li class="category-item all">
                        <figure>
                            <img src="@book.Rasm" alt="@book.Nomi" />
                            <figcaption class="bg-orange">
                                <div class="info-block">
                                    <h4>@book.Nomi</h4>
                                    <span class="author"><strong>Muallif:</strong> @book.Mualliflar</span>
                                    <span class="author"><strong>ISBN:</strong> @book.ISBN</span>
                                    <div class="rating">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= Math.Floor(book.OrtachaBaho))
                                            {
                                                <span>★</span>
                                            }
                                            else
                                            {
                                                <span>☆</span>
                                            }
                                        }
                                    </div>
                                    <p>@book.Kategoriyalar | @book.MediaTuri</p>
                                    <a asp-controller="Book" asp-action="Details" asp-route-id="@book.Id">Batafsil <i class="fa fa-long-arrow-right"></i></a>
                                    <ol>
                                        <li><a href="#"><i class="fa fa-shopping-cart"></i></a></li>
                                        <li><a href="#"><i class="fa fa-heart"></i></a></li>
                                        <li><a href="#"><i class="fa fa-envelope"></i></a></li>
                                        <li><a href="#"><i class="fa fa-share-alt"></i></a></li>
                                        <li><a asp-controller="Book" asp-action="Details" asp-route-id="@book.Id"><i class="fa fa-search"></i></a></li>
                                    </ol>
                                </div>
                            </figcaption>
                        </figure>
                    </li>
                }
            </ul>
            <div class="center-content">
                <a asp-controller="Book" asp-action="Index" class="btn btn-primary">Ko‘proq ko‘rsatish</a>
            </div>
        </div>
    </section>
}
else
{
    <!-- Qidiruv natijalari – booksmedia-fullwidth -->
    <div class="booksmedia-fullwidth">
        <div class="container">
            <div class="center-content">
                <h2 class="section-title">Qidiruv natijalari</h2>
                <span class="underline center"></span>
                <p class="lead">“@Model.SearchKeyword” bo‘yicha @Model.SearchResults.Count ta natija topildi.</p>
            </div>
        </div>
        <ul>
            @foreach (var book in Model.SearchResults)
            {
                string iconClass = book.MediaTuri switch
                {
                    "ElektronKitob" => "blue-icon",
                    "AudioKitob" => "yellow-icon",
                    "Jurnal" => "green-icon",
                    "Video" => "red-icon",
                    _ => "light-green-icon"
                };
                <li>
                    <div class="book-list-icon @iconClass"></div>
                    <figure>
                        <a asp-controller="Book" asp-action="Details" asp-route-id="@book.Id">
                            <img src="@book.Rasm" alt="@book.Nomi">
                        </a>
                        <figcaption>
                            <header>
                                <h4><a asp-controller="Book" asp-action="Details" asp-route-id="@book.Id">@book.Nomi</a></h4>
                                <p><strong>Muallif:</strong> @book.Mualliflar</p>
                                <p><strong>ISBN:</strong> @book.ISBN</p>
                            </header>
                            <p>@(book.Tavsif.Length > 150 ? book.Tavsif[..150] + "..." : book.Tavsif)</p>
                            <div class="actions">
                                <ul>
                                    <li><a href="#" data-toggle="tooltip" title="Savatga qo‘shish"><i class="fa fa-shopping-cart"></i></a></li>
                                    <li><a href="#" data-toggle="tooltip" title="Yoqtirish"><i class="fa fa-heart"></i></a></li>
                                    <li><a href="#" data-toggle="tooltip" title="Pochta"><i class="fa fa-envelope"></i></a></li>
                                    <li><a asp-controller="Book" asp-action="Details" asp-route-id="@book.Id" data-toggle="tooltip" title="Batafsil"><i class="fa fa-search"></i></a></li>
                                    <li><a href="#" data-toggle="tooltip" title="Chop etish"><i class="fa fa-print"></i></a></li>
                                    <li><a href="#" data-toggle="tooltip" title="Ulashish"><i class="fa fa-share-alt"></i></a></li>
                                </ul>
                            </div>
                        </figcaption>
                    </figure>
                </li>
            }
        </ul>
        @if (!Model.SearchResults.Any())
        {
            <div class="alert alert-warning text-center">Hech qanday kitob topilmadi. Iltimos, boshqa so‘z bilan qidiring.</div>
        }
    </div>
}

<!-- Features (statik) -->
<section class="features">
    <div class="container">
        <ul>
            <li class="bg-yellow"><div class="feature-box"><i class="yellow"></i><h3>Kitoblar</h3><p>50 000 dan ortiq badiiy, ilmiy, o‘quv adabiyotlari.</p><a class="yellow" href="#">Tanlash <i class="fa fa-long-arrow-right"></i></a></div></li>
            <li class="bg-light-green"><div class="feature-box"><i class="light-green"></i><h3>Elektron kitoblar</h3><p>10 000 dan ortiq elektron kitoblar.</p><a class="light-green" href="#">Tanlash <i class="fa fa-long-arrow-right"></i></a></div></li>
            <li class="bg-blue"><div class="feature-box"><i class="blue"></i><h3>Video materiallar</h3><p>500 dan ortiq hujjatli filmlar, ilmiy-ommabop videolar.</p><a class="blue" href="#">Tanlash <i class="fa fa-long-arrow-right"></i></a></div></li>
            <li class="bg-red"><div class="feature-box"><i class="red"></i><h3>Jurnallar</h3><p>100 dan ortiq ilmiy, adabiy, ommabop jurnallar.</p><a class="red" href="#">Tanlash <i class="fa fa-long-arrow-right"></i></a></div></li>
            <li class="bg-violet"><div class="feature-box"><i class="violet"></i><h3>Audio kitoblar</h3><p>Ko‘zi ojizlar va kitob o‘qishga qulaylik.</p><a class="violet" href="#">Tanlash <i class="fa fa-long-arrow-right"></i></a></div></li>
            <li class="bg-green"><div class="feature-box"><i class="green"></i><h3>Nodir qo‘lyozmalar</h3><p>Qadimgi qo‘lyozmalar, litografiyalar.</p><a class="green" href="#">Tanlash <i class="fa fa-long-arrow-right"></i></a></div></li>
        </ul>
    </div>
</section>

<!-- Newsletter -->
<section class="newsletter section-padding">
    <div class="container">
        <div class="row">
            <div class="col-md-8 col-md-offset-2">
                <div class="center-content">
                    <h2 class="section-title">Yangiliklardan xabardor bo‘ling</h2>
                    <span class="underline center"></span>
                    <p class="lead">Kutubxona yangiliklari, yangi kitoblar, tadbirlar haqida birinchi bo‘lib xabar oling.</p>
                </div>
                <div class="form-group">
                    <input class="form-control" placeholder="Email manzilingizni kiriting!" id="newsletter" name="newsletter" type="email">
                    <input class="form-control" value="Obuna bo‘lish" type="submit">
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Latest Blog (qisqa namuna) -->
<section class="latest-blog section-padding banner">
    <div class="container">
        <div class="center-content">
            <h2 class="section-title">So‘nggi maqolalar</h2>
            <span class="underline center"></span>
            <p class="lead">Kutubxona hayoti, kitob tavsiyalari, adabiy tanqid va boshqa qiziqarli maqolalar.</p>
        </div>
        <div class="tabs-container">
            <div class="tabs-menu">
                <ul>
                    <li class="active"><a href="#" class="bg-yellow"><h3>Kitoblar</h3></a></li>
                    <li><a href="#" class="bg-light-green"><h3>Elektron</h3></a></li>
                    <li><a href="#" class="bg-blue"><h3>Video</h3></a></li>
                    <li><a href="#" class="bg-red"><h3>Jurnallar</h3></a></li>
                    <li><a href="#" class="bg-violet"><h3>Audio</h3></a></li>
                    <li><a href="#" class="bg-green"><h3>Tadqiqot</h3></a></li>
                </ul>
            </div>
            <div class="tabs-list">
                <div class="tab-content active">
                    <article>
                        <figure><img src="~/images/latest-blog-img-home-v1.jpg" alt="Maqola"><figcaption><a href="#"><span class="date">15</span><span class="month">Mar</span></a></figcaption></figure>
                        <div class="post-detail">
                            <div class="info-bar">
                                <div class="comments"><a href="#"><i class="fa fa-comment"></i> 37</a></div>
                                <div class="likes"><a href="#"><i class="fa fa-thumbs-o-up"></i> 110</a></div>
                                <div class="viewed"><a href="#"><i class="fa fa-eye"></i> 180</a></div>
                                <div class="share"><a href="#"><i class="fa fa-share-alt"></i> Ulashish</a></div>
                            </div>
                            <h4>Alisher Navoiyning hayoti va ijodi</h4>
                            <div class="author"><a href="#"><i class="fa fa-user"></i> Akmal Saidov</a></div>
                            <p>Alisher Navoiy – buyuk shoir va mutafakkir...</p>
                            <a class="btn btn-dark-gray">Batafsil</a>
                        </div>
                    </article>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Testimonial -->
<section class="community-testimonial">
    <div class="container">
        <div class="text-center">
            <h2 class="section-title">Kitobxonlarimiz fikri</h2>
            <span class="underline center"></span>
            <p class="lead">Kutubxonamiz haqida sizning fikringiz biz uchun muhim.</p>
        </div>
        <div class="owl-carousel">
            <div class="single-testimonial-box">
                <div class="top-portion">
                    <img src="~/images/testimonial-image-01.jpg" alt="Kitobxon" />
                    <div class="user-comment"><blockquote>Kutubxona xodimlari juda xushmuomala...</blockquote></div>
                </div>
                <div class="bottom-portion">
                    <a href="#" class="author">Aziza Karimova <small>(Talaba)</small></a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- News & Event -->
<section class="news-events section-padding banner">
    <div class="container">
        <div class="center-content">
            <h2 class="section-title c-light">Yangiliklar va tadbirlar</h2>
            <span class="underline center"></span>
            <p class="lead c-light">Kutubxonamizda bo‘lib o‘tadigan eng so‘nggi tadbirlar va yangiliklardan xabardor bo‘ling.</p>
        </div>
        <div class="news-events-list">
            <div class="single-news-event">
                <figure><img src="~/images/news-event/news-event-01.jpg" alt="Tadbir" /></figure>
                <div class="content-block">
                    <div class="member-info">
                        <div class="content_meta_category"><span class="arrow-right"></span><a href="#">TADBIR</a></div>
                        <ul class="news-event-info">
                            <li><i class="fa fa-calendar"></i> 25 Mart, 2025</li>
                            <li><i class="fa fa-clock-o"></i> 15:00 - 17:00</li>
                            <li><i class="fa fa-map-marker"></i> Toshkent, O‘zbekiston</li>
                        </ul>
                        <h3><a href="#">"O‘zbek adabiyoti klassiklari" kechasi</a></h3>
                        <p>Abdulla Qodiriy, Cho‘lpon, Fitrat...</p>
                        <a class="btn btn-primary" href="#">Batafsil</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>