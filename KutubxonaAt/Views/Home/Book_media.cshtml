@using KutubxonaAt.Models
@model IEnumerable<KutubxonaAt.Models.Kitob>
@{
    ViewData["Title"] = "Kitoblar va media ro‘yxati";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<!-- Page Banner -->
<section class="page-banner services-banner">
    <div class="container">
        <div class="banner-header">
            <h2>Kitoblar va media ro‘yxati</h2>
            <span class="underline center"></span>
            <p class="lead">Kutubxona fondidagi barcha kitoblar va media materiallar</p>
        </div>
        <div class="breadcrumb">
            <ul>
                <li><a asp-area="User" asp-controller="Home" asp-action="Index">Bosh sahifa</a></li>
                <li>Kitoblar va media</li>
            </ul>
        </div>
    </div>
</section>

<div id="content" class="site-content">
    <div id="primary" class="content-area">
        <main id="main" class="site-main">
            <div class="books-full-width">
                <div class="container">
                    <!-- Search Section -->
                    <section class="search-filters">
                        <div class="filter-box">
                            <h3>Kutubxonadan nimani qidiryapsiz?</h3>
                            <form method="get" asp-action="Index" asp-controller="Book" id="searchForm">
                                <div class="col-md-4 col-sm-6">
                                    <div class="form-group">
                                        <input class="form-control" placeholder="Kalit so‘z bo‘yicha qidirish" id="keywords" name="keywords" type="text" value="@Context.Request.Query["keywords"]">
                                    </div>
                                </div>
                                <div class="col-md-3 col-sm-6">
                                    <div class="form-group">
                                        <select name="catalog" id="catalog" class="form-control">
                                            <option value="">Katalogni tanlang</option>
                                            <option value="1">Asosiy fond</option>
                                            <option value="2">Elektron fond</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-3 col-sm-6">
                                    <div class="form-group">
                                        <select name="category" id="category" class="form-control">
                                            <option value="">Barcha kategoriyalar</option>
                                            <option value="1">Badiiy adabiyot</option>
                                            <option value="2">Ilmiy adabiyot</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-2 col-sm-6">
                                    <div class="form-group">
                                        <input class="form-control" type="submit" value="Qidirish">
                                    </div>
                                </div>
                            </form>
                        </div>
                    </section>

                    <!-- Sorting options -->
                    <div class="filter-options margin-list">
                        <div class="row">
                            <div class="col-md-3 col-sm-3">
                                <select name="orderby" id="sortBy" class="orderby">
                                    <option value="name">Nomi bo‘yicha saralash</option>
                                    <option value="popular">Ommaboplik bo‘yicha</option>
                                    <option value="rating">Reyting bo‘yicha</option>
                                    <option value="new">Yangiligi bo‘yicha</option>
                                    <option value="price">Narx bo‘yicha</option>
                                </select>
                            </div>
                            <div class="col-md-3 col-sm-3">
                                <select name="authorSort" id="authorSort" class="orderby">
                                    <option value="">Muallif bo‘yicha saralash</option>
                                    <option value="asc">A-Z</option>
                                    <option value="desc">Z-A</option>
                                </select>
                            </div>
                            <div class="col-md-2 col-sm-3">
                                <select name="lang" id="lang" class="orderby">
                                    <option value="">Til</option>
                                    <option value="uz">O‘zbek</option>
                                    <option value="ru">Rus</option>
                                    <option value="en">Ingliz</option>
                                </select>
                            </div>
                            <div class="col-md-2 col-sm-3">
                                <select name="year" id="year" class="orderby">
                                    <option value="">Nashr sanasi</option>
                                    <option value="asc">Eski → Yangi</option>
                                    <option value="desc">Yangi → Eski</option>
                                </select>
                            </div>
                            <div class="col-md-2 col-sm-12 pull-right">
                                <div class="filter-toggle">
                                    <a href="#" class="active"><i class="glyphicon glyphicon-th-large"></i></a>
                                    <a href="#"><i class="glyphicon glyphicon-th-list"></i></a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Books list -->
                    <div class="booksmedia-fullwidth">
                        <ul>
                            @foreach (var book in Model)
                            {
                                var mualliflar = string.Join(", ", book.KitobMualliflari.Select(km => $"{km.Muallif.Familiya} {km.Muallif.Ism}"));
                                string rasmUrl = !string.IsNullOrEmpty(book.Rasm) ? book.Rasm : "/images/books-media/layout-3/default-book.jpg";
                                string iconClass = book.MediaTuri switch
                                {
                                    Kitob.MediaType.ElektronKitob => "blue-icon",
                                    Kitob.MediaType.AudioKitob => "yellow-icon",
                                    Kitob.MediaType.Jurnal => "green-icon",
                                    Kitob.MediaType.Video => "red-icon",
                                    _ => "light-green-icon"
                                };
                                string shortDesc = book.Tavsif?.Length > 150 ? book.Tavsif.Substring(0, 150) + "..." : book.Tavsif ?? "Tavsif mavjud emas";
                                <li>
                                    <div class="book-list-icon @iconClass"></div>
                                    <figure>
                                        <a asp-controller="Book" asp-action="Details" asp-route-id="@book.Id">
                                            <img src="@rasmUrl" alt="@book.Nomi" class="book-thumbnail">
                                        </a>
                                        <figcaption>
                                            <header>
                                                <h4><a asp-controller="Book" asp-action="Details" asp-route-id="@book.Id">@book.Nomi</a></h4>
                                                <p><strong>Muallif:</strong> @mualliflar</p>
                                                <p><strong>ISBN:</strong> @(string.IsNullOrEmpty(book.ISBN) ? "Mavjud emas" : book.ISBN)</p>
                                            </header>
                                            <p>@shortDesc</p>
                                            <div class="actions">
                                                <ul>
                                                    <!-- Savatga qo’shish -->
                                                    <li>
                                                        @if (User.Identity?.IsAuthenticated == true)
                                                        {
                                                            <form method="post" asp-area="User" asp-controller="Cart" asp-action="AddToCart" style="display:inline;">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="kitobId" value="@book.Id" />
                                                                <button type="submit" class="btn-link" style="background:none;border:none;padding:0;color:#333;" data-toggle="tooltip" title="Savatga qo’shish">
                                                                    <i class="fa fa-shopping-cart"></i>
                                                                </button>
                                                            </form>
                                                        }
                                                        else
                                                        {
                                                            <a href="/Account/Login?returnUrl=/User/Book/Details/@book.Id" data-toggle="tooltip" title="Savatga qo’shish (kirish kerak)">
                                                                <i class="fa fa-shopping-cart"></i>
                                                            </a>
                                                        }
                                                    </li>
                                                    <!-- Yoqtirish (front-end toggle) -->
                                                    <li>
                                                        <a href="javascript:void(0)" class="like-btn" data-toggle="tooltip" title="Yoqtirish">
                                                            <i class="fa fa-heart"></i>
                                                        </a>
                                                    </li>
                                                    <!-- Pochta (contact page) -->
                                                    <li>
                                                        <a asp-controller="Home" asp-action="Contact" asp-route-subject="Kitob: @book.Nomi" data-toggle="tooltip" title="Pochta">
                                                            <i class="fa fa-envelope"></i>
                                                        </a>
                                                    </li>
                                                    <!-- Batafsil (Details) -->
                                                    <li>
                                                        <a asp-area="User" asp-controller="Book" asp-action="Details" asp-route-id="@book.Id" data-toggle="tooltip" title="Batafsil">
                                                            <i class="fa fa-search"></i>
                                                        </a>
                                                    </li>
                                                    <!-- Chop etish -->
                                                    <li>
                                                        <a href="javascript:void(0)" onclick="libPrint()" data-toggle="tooltip" title="Chop etish">
                                                            <i class="fa fa-print"></i>
                                                        </a>
                                                    </li>
                                                    <!-- Ulashish -->
                                                    <li>
                                                        @{ var bmShareUrl = Url.Action("Details", "Book", new { area = "User", id = book.Id }, Context.Request.Scheme) ?? "#"; }
                                                        <a href="javascript:void(0)" onclick="libShare('@book.Nomi.Replace("'","\\'")', '@bmShareUrl')" data-toggle="tooltip" title="Ulashish">
                                                            <i class="fa fa-share-alt"></i>
                                                        </a>
                                                    </li>
                                                </ul>
                                            </div>
                                        </figcaption>
                                    </figure>
                                </li>
                            }
                        </ul>
                    </div>

                    <!-- Pagination (static – you can replace with dynamic later) -->
                    <nav class="navigation pagination text-center">
                        <h2 class="screen-reader-text">Post navigatsiyasi</h2>
                        <div class="nav-links">
                            <a class="prev page-numbers" href="#"><i class="fa fa-long-arrow-left"></i> Oldingi</a>
                            <a class="page-numbers" href="#">1</a>
                            <span class="page-numbers current">2</span>
                            <a class="page-numbers" href="#">3</a>
                            <a class="page-numbers" href="#">4</a>
                            <a class="next page-numbers" href="#">Keyingi <i class="fa fa-long-arrow-right"></i></a>
                        </div>
                    </nav>
                </div>
            </div>
        </main>
    </div>
</div>

<script>
    // Yoqtirish (like) toggle – faqat front-end
    document.querySelectorAll('.like-btn').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            this.classList.toggle('liked');
        });
    });

    // Ulashish (share)
    function shareBook(title, url) {
        if (navigator.share) {
            navigator.share({ title: title, url: url }).catch(console.error);
        } else {
            alert("Havolani nusxalang: " + url);
        }
    }
</script>

<style>
    .like-btn i {
        color: #ccc;
        transition: color 0.2s;
    }

    .like-btn.liked i {
        color: #e74c3c;
    }

    .btn-link:hover {
        color: #e74c3c;
        cursor: pointer;
    }
</style>