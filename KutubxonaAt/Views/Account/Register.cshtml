@using KutubxonaAt.ViewModels.Account
@model RegisterViewModel

@{
    ViewData["Title"] = "Ro'yxatdan o'tish";
}

<style>
    /* Umumiy fon */
    body {
        background: linear-gradient(135deg, #f0f4fa, #d9eaff);
        font-family: 'Inter', 'Segoe UI', sans-serif;
    }

    /* Ro‘yxatdan o‘tish qutisi */
    .register-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
    }

    .register-card {
        background: #ffffff;
        border-radius: 24px;
        box-shadow: 0 20px 40px rgba(0,20,50,0.15);
        padding: 40px 35px;
        width: 100%;
        max-width: 750px;
        transition: all 0.3s ease;
    }

        .register-card h2 {
            color: #0b2b4f;
            font-weight: 700;
            font-size: 2rem;
            margin-bottom: 8px;
            text-align: center;
        }

        .register-card .subtitle {
            text-align: center;
            color: #4b5565;
            margin-bottom: 30px;
            font-size: 1rem;
        }

    /* Input guruhlari */
    .form-group-custom {
        margin-bottom: 20px;
    }

        .form-group-custom label {
            font-weight: 600;
            color: #1e293b;
            margin-bottom: 6px;
            display: block;
            font-size: 0.95rem;
        }

    .input-custom {
        width: 100%;
        padding: 12px 16px;
        border-radius: 12px;
        border: 1.5px solid #e2e8f0;
        background: #f8fafc;
        font-size: 1rem;
        transition: 0.2s;
        color: #0f172a;
    }

        .input-custom:focus {
            border-color: #2563eb;
            background: #ffffff;
            box-shadow: 0 0 0 4px rgba(37,99,235,0.15);
            outline: none;
        }

        .input-custom.is-invalid {
            border-color: #dc2626;
        }

    .invalid-feedback {
        color: #dc2626;
        font-size: 0.85rem;
        margin-top: 5px;
    }

    /* Majburiy yulduzcha */
    .required-star {
        color: #dc2626;
        margin-left: 4px;
    }

    /* Tugma */
    .btn-register {
        background: linear-gradient(135deg, #2563eb, #1e40af);
        border: none;
        border-radius: 40px;
        padding: 14px 20px;
        font-weight: 600;
        font-size: 1.1rem;
        color: white;
        width: 100%;
        margin-top: 15px;
        transition: 0.3s;
        box-shadow: 0 8px 20px rgba(37,99,235,0.3);
    }

        .btn-register:hover {
            background: linear-gradient(135deg, #1d4ed8, #1e3a8a);
            transform: translateY(-2px);
            box-shadow: 0 12px 25px rgba(37,99,235,0.4);
        }

    /* Havola */
    .login-link {
        text-align: center;
        margin-top: 25px;
    }

        .login-link a {
            color: #2563eb;
            font-weight: 500;
            text-decoration: none;
        }

            .login-link a:hover {
                text-decoration: underline;
            }

    /* Breadcrumb (agar kerak bo‘lsa, sizning loyihangizga mos) */
    .breadcrumb-custom {
        background: transparent;
        padding: 10px 0;
        margin-bottom: 0;
    }

        .breadcrumb-custom ul {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            gap: 8px;
        }

        .breadcrumb-custom li + li:before {
            content: "/";
            margin-right: 8px;
            color: #94a3b8;
        }

        .breadcrumb-custom a {
            color: #ffffffcc;
            text-decoration: none;
        }

            .breadcrumb-custom a:hover {
                color: white;
            }

    /* Page Banner (sizning loyihangizdagi classlar bilan mos) */
    .page-banner {
        background: linear-gradient(135deg, #0b2b4f, #1e4b8a);
        padding: 50px 0;
        color: white;
    }
</style>

<!-- Page Banner -->
<section class="page-banner services-banner">
    <div class="container">
        <div class="banner-header text-center">
            <h2>Ro'yxatdan o'tish</h2>
            <span class="underline center"></span>
            <p class="lead">Yangi hisob yaratish</p>
        </div>
        <div class="breadcrumb-custom d-flex justify-content-center">
            <ul>
                <li><a asp-action="Index" asp-controller="Home">Bosh sahifa</a></li>
                <li>Ro'yxatdan o'tish</li>
            </ul>
        </div>
    </div>
</section>

<!-- Register Form -->
<div class="register-wrapper">
    <div class="register-card">
        <h2>Yangi hisob yaratish</h2>
        <p class="subtitle">Kerakli ma'lumotlarni kiriting</p>

        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- 3 ustun: Ism, Familiya, Sharif -->
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="form-group-custom">
                        <label asp-for="Ism">Ism <span class="required-star">*</span></label>
                        <input asp-for="Ism" class="input-custom" placeholder="Ismingiz" />
                        <span asp-validation-for="Ism" class="invalid-feedback"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group-custom">
                        <label asp-for="Familiya">Familiya <span class="required-star">*</span></label>
                        <input asp-for="Familiya" class="input-custom" placeholder="Familiyangiz" />
                        <span asp-validation-for="Familiya" class="invalid-feedback"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group-custom">
                        <label asp-for="Sharif">Otasining ismi</label>
                        <input asp-for="Sharif" class="input-custom" placeholder="Otasining ismi" />
                        <span asp-validation-for="Sharif" class="invalid-feedback"></span>
                    </div>
                </div>
            </div>

            <!-- Email va Telefon -->
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="form-group-custom">
                        <label asp-for="Email">Email <span class="required-star">*</span></label>
                        <input asp-for="Email" class="input-custom" placeholder="example@mail.com" />
                        <span asp-validation-for="Email" class="invalid-feedback"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group-custom">
                        <label asp-for="Telefon">Telefon raqami</label>
                        <input asp-for="Telefon" class="input-custom" placeholder="+998 90 123 45 67" />
                        <span asp-validation-for="Telefon" class="invalid-feedback"></span>
                    </div>
                </div>
            </div>

            <!-- Parol va tasdiqlash -->
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="form-group-custom">
                        <label asp-for="Password">Parol <span class="required-star">*</span></label>
                        <input asp-for="Password" class="input-custom" type="password" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="invalid-feedback"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group-custom">
                        <label asp-for="ConfirmPassword">Parolni tasdiqlang <span class="required-star">*</span></label>
                        <input asp-for="ConfirmPassword" class="input-custom" type="password" placeholder="••••••••" />
                        <span asp-validation-for="ConfirmPassword" class="invalid-feedback"></span>
                    </div>
                </div>
            </div>

            <!-- Manzil va Tug'ilgan sana -->
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="form-group-custom">
                        <label asp-for="Manzil">Manzil</label>
                        <input asp-for="Manzil" class="input-custom" placeholder="Yashash manzili" />
                        <span asp-validation-for="Manzil" class="invalid-feedback"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group-custom">
                        <label asp-for="TugilganSana">Tug'ilgan sana</label>
                        <input asp-for="TugilganSana" class="input-custom" type="date" />
                        <span asp-validation-for="TugilganSana" class="invalid-feedback"></span>
                    </div>
                </div>
            </div>

            <!-- Foydalanuvchi turi, Fakultet, Guruh -->
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="form-group-custom">
                        <label asp-for="Turi">Foydalanuvchi turi <span class="required-star">*</span></label>
                        <select asp-for="Turi" class="input-custom">
                            <option value="">-- Tanlang --</option>
                            <option value="Talaba">Talaba</option>
                            <option value="O'qituvchi">O'qituvchi</option>
                            <option value="Xodim">Xodim</option>
                            <option value="Nafaqaxo'r">Nafaqaxo'r</option>
                            <option value="Tadbirkor">Tadbirkor</option>
                            <option value="Boshqa">Boshqa</option>
                        </select>
                        <span asp-validation-for="Turi" class="invalid-feedback"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group-custom">
                        <label asp-for="Fakultet">Fakultet</label>
                        <input asp-for="Fakultet" class="input-custom" placeholder="Fakultet nomi" />
                        <span asp-validation-for="Fakultet" class="invalid-feedback"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group-custom">
                        <label asp-for="Guruh">Guruh</label>
                        <input asp-for="Guruh" class="input-custom" placeholder="Guruh raqami" />
                        <span asp-validation-for="Guruh" class="invalid-feedback"></span>
                    </div>
                </div>
            </div>

            <!-- Talaba ID -->
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group-custom">
                        <label asp-for="TalabaId">Talaba ID</label>
                        <input asp-for="TalabaId" class="input-custom" placeholder="ID raqami" />
                        <span asp-validation-for="TalabaId" class="invalid-feedback"></span>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn-register">Ro'yxatdan o'tish</button>
        </form>

        <div class="login-link">
            <p>Hisobingiz bormi? <a asp-action="Login">Kirish</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}