@using KutubxonaAt.Models.ViewModels.Account
@model ForgotPasswordViewModel

@{
    ViewData["Title"] = "Parolni tiklash";
}
<style>
    /* Sahifa fon */
    body {
        background: linear-gradient(135deg,#eef2f7,#dbeafe);
        font-family: 'Segoe UI', sans-serif;
    }

    /* Login konteyner */
    .signin-main {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 80px 0;
    }

    /* Forma */
    .company-detail {
        background: white;
        padding: 40px;
        border-radius: 12px;
        width: 400px;
        box-shadow: 0 10px 35px rgba(0,0,0,0.15);
    }

    /* Sarlavha */
    .signin-head h2 {
        text-align: center;
        color: #1e3a8a;
        font-weight: 700;
        margin-bottom: 30px;
    }

    /* Label */
    .form-row label {
        font-weight: 600;
        color: #374151;
    }

    /* Input */
    .input-text {
        width: 100%;
        padding: 12px 15px;
        border-radius: 8px;
        border: 1px solid #d1d5db;
        background: white !important;
        color: #111 !important;
        font-size: 15px;
    }

        .input-text:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59,130,246,0.25);
            outline: none;
        }

    /* Tugma */
    .btn-default {
        width: 100%;
        margin-top: 15px;
        padding: 12px;
        border: none;
        border-radius: 8px;
        background: linear-gradient(135deg,#3b82f6,#1e40af);
        color: white;
        font-weight: 600;
        font-size: 16px;
        transition: 0.3s;
    }

        .btn-default:hover {
            background: linear-gradient(135deg,#2563eb,#1e3a8a);
        }

    /* Linklar */
    a {
        color: #2563eb;
    }

        a:hover {
            text-decoration: underline;
        }

    /* Xatolik */
    .text-danger {
        color: #ef4444;
    }
</style>

<!-- Start: Page Banner -->
<section class="page-banner services-banner">
    <div class="container">
        <div class="banner-header">
            <h2>Parolni tiklash</h2>
            <span class="underline center"></span>
            <p class="lead">Email manzilingizni kiriting, biz sizga tiklash linkini yuboramiz</p>
        </div>
        <div class="breadcrumb">
            <ul>
                <li><a asp-action="Index" asp-controller="Home">Bosh sahifa</a></li>
                <li>Parolni tiklash</li>
            </ul>
        </div>
    </div>
</section>
<!-- End: Page Banner -->
<!-- Start: ForgotPassword Section -->
<div id="content" class="site-content">
    <div id="primary" class="content-area">
        <main id="main" class="site-main">
            <div class="signin-main">
                <div class="container">
                    <div class="woocommerce">
                        <div class="woocommerce-login">
                            <div class="company-info signin-register">
                                <div class="col-md-6 col-md-offset-3">
                                    <div class="row">
                                        <div class="col-md-12">
                                            <div class="company-detail">
                                                <div class="signin-head">
                                                    <h2>Parolni tiklash</h2>
                                                    <span class="underline left"></span>
                                                </div>
                                                <form asp-action="ForgotPassword" method="post">
                                                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                                                    <p class="form-row input-required">
                                                        <label asp-for="Email">Email</label>
                                                        <span class="second-letter">*</span>
                                                        <input asp-for="Email" class="input-text" />
                                                        <span asp-validation-for="Email" class="text-danger"></span>
                                                    </p>

                                                    <button type="submit" class="button btn btn-default">Yuborish</button>
                                                </form>
                                                <div class="text-center" style="margin-top:20px;">
                                                    <p><a asp-action="Login">Kirish sahifasiga qaytish</a></p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
<!-- End: ForgotPassword Section -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}