@{
    ViewData["Title"] = "Parolni tiklash so'rovi yuborildi";
}

<style>
    body {
        background: linear-gradient(135deg, #eef2f7, #dbeafe);
        font-family: 'Segoe UI', sans-serif;
    }

    .confirmation-container {
        max-width: 600px;
        margin: 80px auto;
        background: white;
        padding: 40px;
        border-radius: 12px;
        box-shadow: 0 10px 35px rgba(0,0,0,0.15);
        text-align: center;
    }

    h2 {
        color: #1e3a8a;
        font-weight: 700;
        margin-bottom: 20px;
    }

    p {
        color: #374151;
        font-size: 16px;
        line-height: 1.6;
        margin-bottom: 20px;
    }

    .alert-info {
        background-color: #dbeafe;
        border: 1px solid #3b82f6;
        color: #1e3a8a;
        padding: 15px;
        border-radius: 8px;
        margin-top: 20px;
        word-break: break-word;
    }

    .btn-primary {
        display: inline-block;
        padding: 12px 30px;
        border: none;
        border-radius: 8px;
        background: linear-gradient(135deg, #3b82f6, #1e40af);
        color: white;
        font-weight: 600;
        font-size: 16px;
        text-decoration: none;
        transition: background 0.3s;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #2563eb, #1e3a8a);
            color: white;
            text-decoration: none;
        }

    a {
        color: #2563eb;
    }

        a:hover {
            text-decoration: underline;
        }
</style>

<div class="confirmation-container">
    <h2>@ViewData["Title"]</h2>
    <p>
        Agar sizning email manzilingiz tizimda mavjud bo'lsa, parolni tiklash bo'yicha ko'rsatmalar emailingizga yuboriladi.
        Iltimos, emailingizni tekshiring.
    </p>

    @if (TempData["ResetToken"] != null)
    {
        <div class="alert-info">
            <strong>Test uchun token (faqat development):</strong><br />
            <a asp-action="ResetPassword"
               asp-route-email="@TempData["Email"]"
               asp-route-token="@TempData["ResetToken"]">
                Parolni tiklash uchun shu yerga bosing
            </a>
        </div>
    }

    <p style="margin-top: 30px;">
        <a asp-action="Login" class="btn-primary">Kirish sahifasiga qaytish</a>
    </p>
</div>