@using KutubxonaAt.ViewModels.Account
@model LoginViewModel

@{
    ViewData["Title"] = "Kirish";
}
<style>
    /* Sahifa fon */
    body {
        background: linear-gradient(135deg, #eef2f7, #dbeafe);
        font-family: 'Segoe UI', sans-serif;
        margin: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    /* Login konteyner - to'liq markaz */
    .signin-main {
        display: flex;
        justify-content: center;
        align-items: center;
        flex: 1;
        padding: 20px;
    }

    /* Forma - shaffof fon */
    .company-detail {
        background: rgba(255, 255, 255, 0.85); /* shaffoflik */
        backdrop-filter: blur(8px); /* orqa fonni xiralashtirish (ixtiyoriy) */
        padding: 40px;
        border-radius: 12px;
        width: 100%;
        max-width: 400px;
        box-shadow: 0 10px 35px rgba(0,0,0,0.15);
        margin: 0 auto;
    }

    /* Sarlavha */
    .signin-head h2 {
        text-align: center;
        color: #1e3a8a;
        font-weight: 700;
        margin-bottom: 30px;
    }

    /* Label */
    .form-row label {
        font-weight: 600;
        color: #374151;
    }

    /* Input */
    .input-text {
        width: 100%;
        padding: 12px 15px;
        border-radius: 8px;
        border: 1px solid #d1d5db;
        background: white !important;
        color: #111 !important;
        font-size: 15px;
    }

        .input-text:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59,130,246,0.25);
            outline: none;
        }

    /* Checkbox */
    input[type="checkbox"] {
        margin-right: 8px;
    }

    /* Tugma */
    .btn-default {
        width: 100%;
        margin-top: 15px;
        padding: 12px;
        border: none;
        border-radius: 8px;
        background: linear-gradient(135deg,#3b82f6,#1e40af);
        color: white;
        font-weight: 600;
        font-size: 16px;
        transition: 0.3s;
    }

        .btn-default:hover {
            background: linear-gradient(135deg,#2563eb,#1e3a8a);
        }

    /* Linklar */
    a {
        color: #2563eb;
    }

        a:hover {
            text-decoration: underline;
        }

    /* Xatolik */
    .text-danger {
        color: #ef4444;
    }

    /* Eslab qol va parolni unutish */
    .password-form-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 10px 0 0;
    }
</style>

<!-- Start: Page Banner (agar kerak bo‘lsa, olib tashlash mumkin) -->
<section class="page-banner services-banner">
    <div class="container">
        <div class="banner-header">
            <h2>Kirish</h2>
            <span class="underline center"></span>
            <p class="lead">Tizimga kirish uchun maʼlumotlaringizni kiriting</p>
        </div>
        <div class="breadcrumb">
            <ul>
                <li><a asp-action="Index" asp-controller="Home">Bosh sahifa</a></li>
                <li>Kirish</li>
            </ul>
        </div>
    </div>
</section>
<!-- End: Page Banner -->
<!-- Start: Login Section -->
<div id="content" class="site-content">
    <div id="primary" class="content-area">
        <main id="main" class="site-main">
            <div class="signin-main">
                <div class="container">
                    <div class="woocommerce">
                        <div class="woocommerce-login">
                            <div class="company-info signin-register">
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="company-detail">
                                            <div class="signin-head">
                                                <h2>Tizimga kirish</h2>
                                                <span class="underline left"></span>
                                            </div>
                                            <form asp-action="Login" method="post">
                                                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                                                <p class="form-row input-required">
                                                    <label asp-for="Email">Email</label>
                                                    <span class="second-letter">*</span>
                                                    <input asp-for="Email" class="input-text" />
                                                    <span asp-validation-for="Email" class="text-danger"></span>
                                                </p>

                                                <p class="form-row input-required">
                                                    <label asp-for="Password">Parol</label>
                                                    <span class="second-letter">*</span>
                                                    <input asp-for="Password" class="input-text" type="password" />
                                                    <span asp-validation-for="Password" class="text-danger"></span>
                                                </p>

                                                <div class="password-form-row">
                                                    <p class="form-row input-checkbox">
                                                        <input asp-for="RememberMe" />
                                                        <label class="inline" asp-for="RememberMe">Eslab qol</label>
                                                    </p>
                                                    <p class="lost_password">
                                                        <a asp-action="ForgotPassword">Parolni unutdingizmi?</a>
                                                    </p>
                                                </div>

                                                <button type="submit" class="button btn btn-default">Kirish</button>
                                            </form>
                                            <div class="text-center" style="margin-top:20px;">
                                                <p>Hisobingiz yo'qmi? <a asp-action="Register">Ro'yxatdan o'tish</a></p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
<!-- End: Login Section -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}