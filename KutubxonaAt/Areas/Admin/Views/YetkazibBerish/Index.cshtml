@model IEnumerable<KutubxonaAt.Models.YetkazibBerish>
@{
    ViewData["Title"] = "Yetkazib berishlar";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="row">
    <div class="col-md-4">
        <div class="panel panel-warning">
            <div class="panel-body text-center">
                <h2>@ViewBag.Tayyorlanmoqda</h2><p>Tayyorlanmoqda</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="panel panel-info">
            <div class="panel-body text-center">
                <h2>@ViewBag.Yolda</h2><p>Yo'lda</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="panel panel-success">
            <div class="panel-body text-center">
                <h2>@ViewBag.Yetkazildi</h2><p>Yetkazildi</p>
            </div>
        </div>
    </div>
</div>

<div class="panel panel-default">
    <div class="panel-heading">
        <h3 class="panel-title">
            <i class="fa fa-truck"></i> Yetkazib berish buyurtmalari
            <div class="pull-right">
                <a asp-route-holat="Tayyorlanmoqda" class="btn btn-xs btn-warning">Tayyorlanmoqda</a>
                <a asp-route-holat="Yo'lda" class="btn btn-xs btn-info">Yo'lda</a>
                <a asp-route-holat="" class="btn btn-xs btn-default">Barchasi</a>
            </div>
        </h3>
    </div>
    <div class="panel-body">
        @if (TempData["Xabar"] != null)
        {
            <div class="alert alert-success alert-dismissible">
                <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                @TempData["Xabar"]
            </div>
        }
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Kuzatuv</th>
                        <th>Foydalanuvchi</th>
                        <th>Kitob</th>
                        <th>Manzil</th>
                        <th>Narx</th>
                        <th>Sana</th>
                        <th>Holat</th>
                        <th>Amallar</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var y in Model)
                    {
                        var kitobNomi = y.Beruv?.KitobNusxa?.Kitob?.Nomi ?? y.Bron?.Kitob?.Nomi ?? "—";
                        <tr>
                            <td><code>#@y.KuzatuvRaqami</code></td>
                            <td>
                                @y.Foydalanuvchi?.Ism @y.Foydalanuvchi?.Familiya
                                <br /><small>@y.TelefонRaqam</small>
                            </td>
                            <td><small>@kitobNomi</small></td>
                            <td><small>@y.Manzil</small></td>
                            <td>@(y.YetkazishNarxi == 0 ? "Bepul" : y.YetkazishNarxi.ToString("N0") + " so'm")</td>
                            <td>@y.BuyurtmaSana.ToString("dd.MM.yyyy")</td>
                            <td>
                                <span class="label label-@(y.Holati == "Tayyorlanmoqda" ? "warning" : y.Holati == "Yo'lda" ? "info" : y.Holati == "Yetkazildi" ? "success" : "default")">
                                    @y.Holati
                                </span>
                            </td>
                            <td>
                                @if (y.Holati == "Tayyorlanmoqda")
                                {
                                    <button type="button" class="btn btn-xs btn-info"
                                        data-toggle="modal" data-target="#holatModal"
                                        data-id="@y.Id" data-holat="Yo'lda">
                                        <i class="fa fa-truck"></i> Yo'lga chiqarish
                                    </button>
                                }
                                else if (y.Holati == "Yo'lda")
                                {
                                    <form asp-action="HolatOzgartir" method="post" style="display:inline;">
                                        <input type="hidden" name="id" value="@y.Id" />
                                        <input type="hidden" name="yangiHolat" value="Yetkazildi" />
                                        <button type="submit" class="btn btn-xs btn-success">
                                            <i class="fa fa-check"></i> Yetkazildi
                                        </button>
                                    </form>
                                }
                                <a asp-action="Detallar" asp-route-id="@y.Id"
                                   class="btn btn-xs btn-default">Ko'rish</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Haydovchi tayinlash modal -->
<div class="modal fade" id="holatModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                <h4 class="modal-title">Haydovchi tayinlash</h4>
            </div>
            <form asp-action="HolatOzgartir" method="post">
                <div class="modal-body">
                    <input type="hidden" name="id" id="modalId" />
                    <input type="hidden" name="yangiHolat" value="Yo'lda" />
                    <div class="form-group">
                        <label>Haydovchi ismi</label>
                        <input name="haydovchi" class="form-control" placeholder="Ism va telefon" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Yo'lga chiqarish</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $('#holatModal').on('show.bs.modal', function (e) {
            var id = $(e.relatedTarget).data('id');
            $('#modalId').val(id);
        });
    </script>
}
