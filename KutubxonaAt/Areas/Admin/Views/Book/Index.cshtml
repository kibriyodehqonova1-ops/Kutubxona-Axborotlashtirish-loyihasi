@using KutubxonaAt.Models
@using static KutubxonaAt.Models.Kitob
@model IEnumerable<KutubxonaAt.Models.Kitob>
@{
    ViewData["Title"] = "Kitoblar";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="content-wrapper">
    <div class="page-header">
        <h3 class="page-title">Kitoblar</h3>
        <a asp-action="Create" class="btn btn-primary">+ Yangi kitob</a>
    </div>

    <div class="row">
        <div class="col-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Rasm</th>
                                    <th>Nomi</th>
                                    <th>Mualliflar</th>
                                    <th>Kategoriyalar</th>
                                    <th>Tur</th>
                                    <th>Nashr yili</th>
                                    <th>Nusxalar</th>
                                    <th>Amallar</th>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.Id</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.Rasm))
                                            {
                                                <img src="@item.Rasm" style="height: 50px;" />
                                            }
                                            else
                                            {
                                                <span class="text-muted">yo‘q</span>
                                            }
                                        </td>
                                        <td>@item.Nomi</td>
                                        <td>@string.Join(", ", item.KitobMualliflari.Select(km => km.Muallif.Familiya + " " + km.Muallif.Ism))</td>
                                        <td>@string.Join(", ", item.KitobKategoriyalari.Select(kk => kk.Kategoriya.Nomi))</td>
                                        <td>
                                            @{
                                                var mediaTypeName = item.MediaTuri switch
                                                {
                                                    MediaType.Kitob => "Kitob",
                                                    MediaType.ElektronKitob => "Elektron kitob",
                                                    MediaType.AudioKitob => "Audio kitob",
                                                    MediaType.Jurnal => "Jurnal",
                                                    MediaType.Video => "Video",
                                                    _ => "Noma'lum"
                                                };
                                            }
                                            <span class="badge @(item.MediaTuri == MediaType.Kitob ? "bg-secondary" :
                                                                                                                item.MediaTuri == MediaType.ElektronKitob ? "bg-primary" :
                                                                                                                item.MediaTuri == MediaType.AudioKitob ? "bg-info" :
                                                                                                                item.MediaTuri == MediaType.Jurnal ? "bg-success" : "bg-warning")">
                                            @mediaTypeName
                                        </span>
                                    </td>
                                    <td>@item.NashrYili</td>
                                    <td>@item.MavjudNusxalar / @item.NusxalarSoni</td>
                                    <td>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Tahrirlash</a>
                                        <a asp-controller="BookCopy" asp-action="Index" asp-route-bookId="@item.Id" class="btn btn-sm btn-info">Nusxalar</a>
                                        <form asp-action="Delete" method="post" style="display:inline;">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Haqiqatan ham o‘chirmoqchimisiz?')">O‘chirish</button>
                                        </form>
                                    </td>
                                </tr>
                                                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>