@model KutubxonaAt.ViewModels.BookCopy.BookCopyEditViewModel
@{
    ViewData["Title"] = "Nusxani tahrirlash";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="content-wrapper">
    <div class="page-header">
        <h3 class="page-title">Nusxani tahrirlash</h3>
    </div>
    <div class="row">
        <div class="col-md-6 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Kitob: @Model.KitobNomi</h4>
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="KitobId" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="form-group">
                            <label asp-for="InventarRaqami"></label>
                            <input asp-for="InventarRaqami" class="form-control" />
                            <span asp-validation-for="InventarRaqami" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="BarKod"></label>
                            <input asp-for="BarKod" class="form-control" />
                            <span asp-validation-for="BarKod" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="RFID"></label>
                            <input asp-for="RFID" class="form-control" />
                            <span asp-validation-for="RFID" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="QabulQilinganSana"></label>
                            <input asp-for="QabulQilinganSana" type="date" class="form-control" />
                            <span asp-validation-for="QabulQilinganSana" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="KelibChiqishi"></label>
                            <input asp-for="KelibChiqishi" class="form-control" />
                            <span asp-validation-for="KelibChiqishi" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Narxi"></label>
                            <input asp-for="Narxi" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="Narxi" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Holati"></label>
                            <select asp-for="Holati" class="form-control" asp-items="ViewBag.StatusOptions"></select>
                            <span asp-validation-for="Holati" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="JismoniyHolati"></label>
                            <select asp-for="JismoniyHolati" class="form-control" asp-items="ViewBag.ConditionOptions"></select>
                            <span asp-validation-for="JismoniyHolati" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Joylashuv"></label>
                            <input asp-for="Joylashuv" class="form-control" />
                            <span asp-validation-for="Joylashuv" class="text-danger"></span>
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="OquvZalidanChiqmaydi" class="form-check-input" />
                            <label asp-for="OquvZalidanChiqmaydi" class="form-check-label"></label>
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="Cheklangan" class="form-check-input" />
                            <label asp-for="Cheklangan" class="form-check-label"></label>
                        </div>

                        <div class="form-group">
                            <label asp-for="OxirgiInventarizatsiya"></label>
                            <input asp-for="OxirgiInventarizatsiya" type="date" class="form-control" />
                            <span asp-validation-for="OxirgiInventarizatsiya" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Izoh"></label>
                            <textarea asp-for="Izoh" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="Izoh" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary me-2">Saqlash</button>
                        <a asp-action="Index" asp-route-bookId="@Model.KitobId" class="btn btn-light">Bekor qilish</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>