@{
    ViewData["Title"] = "Moliyaviy hisobot";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    int yil = ViewBag.Yil;
}

<div class="panel panel-default">
    <div class="panel-heading">
        <h3 class="panel-title">
            <i class="fa fa-money"></i> Moliyaviy hisobot — @yil yil
            <div class="pull-right">
                <a asp-route-yil="@(yil-1)" class="btn btn-xs btn-default">◀ @(yil-1)</a>
                <a asp-route-yil="@(yil+1)" class="btn btn-xs btn-default">@(yil+1) ▶</a>
            </div>
        </h3>
    </div>
    <div class="panel-body">
        <div class="alert alert-success">
            <strong>@yil yil jami daromad: @(((decimal)ViewBag.JamiDaromad).ToString("N0")) so'm</strong>
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Oy</th>
                        <th>Jarima</th>
                        <th>Abonement</th>
                        <th>Sotuv</th>
                        <th>Jami</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var hisobot = ViewBag.OylikHisobot as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
                        foreach (var row in hisobot)
                        {
                            <tr>
                                <td>@row.Oy</td>
                                <td>@(((decimal)row.Jarima).ToString("N0")) so'm</td>
                                <td>@(((decimal)row.Abonement).ToString("N0")) so'm</td>
                                <td>@(((decimal)row.Sotuv).ToString("N0")) so'm</td>
                                <td><strong>@(((decimal)row.Jami).ToString("N0")) so'm</strong></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<a asp-action="Index" class="btn btn-default"><i class="fa fa-arrow-left"></i> Orqaga</a>
