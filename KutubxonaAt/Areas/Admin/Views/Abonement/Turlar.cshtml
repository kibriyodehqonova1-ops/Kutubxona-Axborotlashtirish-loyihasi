@model IEnumerable<KutubxonaAt.Models.AbonementTuri>
@{
    ViewData["Title"] = "Abonement turlari";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">
                    <i class="fa fa-star"></i> Abonement turlari
                    <a asp-action="TurYaratish" class="btn btn-sm btn-primary pull-right">
                        <i class="fa fa-plus"></i> Yangi tur
                    </a>
                </h3>
            </div>
            <div class="panel-body">
                @if (TempData["Xabar"] != null)
                {
                    <div class="alert alert-success alert-dismissible">
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                        @TempData["Xabar"]
                    </div>
                }
                <div class="table-responsive">
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Nomi</th>
                                <th>Narxi</th>
                                <th>Davomiylik</th>
                                <th>Bepul kitoblar</th>
                                <th>Chegirma</th>
                                <th>Maks kitob</th>
                                <th>Bepul yetkazish</th>
                                <th>Holat</th>
                                <th>Amallar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tur in Model)
                            {
                                <tr>
                                    <td><strong>@tur.Nomi</strong><br /><small class="text-muted">@tur.Tavsif</small></td>
                                    <td>@tur.Narxi.ToString("N0") so'm</td>
                                    <td>@tur.DavomiylikKun kun</td>
                                    <td>@tur.BepulKitoblarSoni ta/oy</td>
                                    <td>@tur.ChegirimFoizi%</td>
                                    <td>@tur.MaksimalKitoblar ta</td>
                                    <td>
                                        @if (tur.BepulYetkazish)
                                        {
                                            <span class="label label-success">Ha</span>
                                        }
                                        else
                                        {
                                            <span class="label label-default">Yo'q</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="label label-@(tur.Faol ? "success" : "default")">
                                            @(tur.Faol ? "Faol" : "Nofaol")
                                        </span>
                                    </td>
                                    <td>
                                        <a asp-action="TurTahrirla" asp-route-id="@tur.Id"
                                           class="btn btn-xs btn-info">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                        <form asp-action="TurHolat" method="post" style="display:inline;">
                                            <input type="hidden" name="id" value="@tur.Id" />
                                            <button type="submit" class="btn btn-xs btn-@(tur.Faol ? "warning" : "success")">
                                                @(tur.Faol ? "O'chirish" : "Faollashtirish")
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
