@using System.Security.Claims
<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kutubxona AT</title>

    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700&display=swap" rel="stylesheet" />
    <link href="~/css/font-awesome.min.css" rel="stylesheet" />
    <link href="~/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/style.css" rel="stylesheet" />
    <link href="~/css/site-custom.css" rel="stylesheet" />
</head>
<body>

@{
    var ctrl     = ViewContext.RouteData.Values["controller"]?.ToString();
    var act      = ViewContext.RouteData.Values["action"]?.ToString();
    bool isAuth      = User.Identity?.IsAuthenticated ?? false;
    bool isLibrarian = isAuth && User.IsInRole("Librarian");
    bool isAdmin     = isAuth && User.IsInRole("Admin");
    bool isStaff     = isLibrarian || isAdmin;

    int cartCount = 0;
    if (isAuth)
    {
        var cartJson = Context.Session.GetString("ShoppingCart");
        if (!string.IsNullOrEmpty(cartJson))
        {
            try {
                var cartItems = System.Text.Json.JsonSerializer.Deserialize<System.Collections.Generic.List<System.Text.Json.JsonElement>>(cartJson);
                cartCount = cartItems?.Count ?? 0;
            } catch { }
        }
    }
}

<!-- ═══ NAVBAR ═══════════════════════════════════════════ -->
<header class="navbar-wrapper">
    <div class="container">
        <nav class="lib-navbar">

            <!-- Logo -->
            <a class="lib-navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="fa fa-book"></i> Kutubxona AT
            </a>

            <!-- Desktop menyusi -->
            <ul class="lib-nav-links">
                @if (isAuth)
                {
                    <li class="@(ctrl == "Home" && act == "Index" ? "active" : "")">
                        <a asp-area="User" asp-controller="Home" asp-action="Index">
                            <i class="fa fa-home"></i> Bosh sahifa
                        </a>
                    </li>
                }
                <li class="@(ctrl == "Book" ? "active" : "")">
                    <a asp-area="User" asp-controller="Book" asp-action="Index">
                        <i class="fa fa-search"></i> Katalog
                    </a>
                </li>

                @if (isAuth)
                {
                    <li class="@(ctrl == "Loan" ? "active" : "")">
                        <a asp-area="User" asp-controller="Loan" asp-action="Index">
                            <i class="fa fa-book"></i> @(isStaff ? "Beruvlar" : "Kitoblarim")
                        </a>
                    </li>
                    <li class="@(ctrl == "Reservation" ? "active" : "")">
                        <a asp-area="User" asp-controller="Reservation" asp-action="Index">
                            <i class="fa fa-calendar"></i> @(isStaff ? "Bronlar" : "Bronlarim")
                        </a>
                    </li>
                    <li class="@(ctrl == "Fine" ? "active" : "")">
                        <a asp-area="User" asp-controller="Fine" asp-action="Index">
                            <i class="fa fa-exclamation-triangle"></i> Jarimalar
                        </a>
                    </li>

                    @if (!isStaff)
                    {
                        <li class="lib-dropdown @(ctrl == "Abonement" || ctrl == "KutishRoyxati" || ctrl == "YetkazibBerish" || ctrl == "Purchase" ? "active" : "")">
                            <a href="javascript:void(0)">
                                <i class="fa fa-th-large"></i> Xizmatlar <i class="fa fa-caret-down"></i>
                            </a>
                            <ul class="lib-dropdown-menu">
                                <li><a asp-area="User" asp-controller="Abonement" asp-action="Index"><i class="fa fa-star"></i> Abonement</a></li>
                                <li><a asp-area="User" asp-controller="Purchase" asp-action="Index"><i class="fa fa-shopping-bag"></i> Xaridlarim</a></li>
                                <li><a asp-area="User" asp-controller="Purchase" asp-action="DigitalLibrary"><i class="fa fa-folder-open"></i> Raqamli kutubxona</a></li>
                                <li><a asp-area="User" asp-controller="KutishRoyxati" asp-action="Index"><i class="fa fa-clock-o"></i> Kutish ro'yxati</a></li>
                                <li><a asp-area="User" asp-controller="YetkazibBerish" asp-action="Index"><i class="fa fa-truck"></i> Yetkazish</a></li>
                            </ul>
                        </li>
                    }

                    @if (isStaff)
                    {
                        <li>
                            <a asp-area="Admin" asp-controller="Home" asp-action="Index">
                                <i class="fa fa-cog"></i> Admin panel
                            </a>
                        </li>
                    }
                }
            </ul>

            <!-- O'ng tomon: savat + profil + hamburger -->
            <div class="lib-nav-right">
                @if (isAuth)
                {
                    @if (!isStaff)
                    {
                        <a asp-area="User" asp-controller="Cart" asp-action="Index"
                           class="lib-cart-btn" title="Savat">
                            <i class="fa fa-shopping-cart"></i>
                            @if (cartCount > 0)
                            {
                                <span class="lib-cart-badge">@cartCount</span>
                            }
                        </a>
                    }
                    <div class="lib-dropdown">
                        <div class="lib-user-btn">
                            <i class="fa fa-user-circle"></i>
                            <span class="hidden-xs">@(User.Identity?.Name?.Split('@')[0] ?? "Profil")</span>
                            <i class="fa fa-caret-down"></i>
                        </div>
                        <ul class="lib-dropdown-menu" style="right:0; left:auto; min-width:180px;">
                            <li><a asp-area="User" asp-controller="Profile" asp-action="Index"><i class="fa fa-user"></i> Profil</a></li>
                            <li><a asp-area="User" asp-controller="Profile" asp-action="ChangePassword"><i class="fa fa-lock"></i> Parol o'zgartirish</a></li>
                            <li style="border-top:1px solid #eee; margin-top:4px; padding-top:4px;">
                                <form asp-area="" asp-controller="Home" asp-action="Index" method="post" style="margin:0;">
                                    <button type="submit" style="width:100%;padding:8px 16px;text-align:left;background:none;border:none;cursor:pointer;font-size:13px;color:#c0392b;display:flex;align-items:center;gap:8px;">
                                        <i class="fa fa-sign-out" style="width:18px;"></i> Chiqish
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a asp-area="" asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm">
                        <i class="fa fa-sign-in"></i> Kirish
                    </a>
                    <a asp-area="" asp-controller="Account" asp-action="Register" class="btn btn-default btn-sm hidden-xs">
                        Ro'yxatdan o'tish
                    </a>
                }

                <button class="lib-hamburger" id="hamburgerBtn" aria-label="Menyu">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </nav>
    </div>
</header>

<!-- ═══ MOBIL MENYU ═══════════════════════════════════════ -->
<div class="lib-mobile-menu" id="mobileMenu">
    <div class="lib-mobile-menu-panel">
        <ul>
            @if (isAuth)
            {
                <li><div class="mobile-divider">ASOSIY</div></li>
                <li><a asp-area="User" asp-controller="Home" asp-action="Index" class="@(ctrl=="Home"?"active-link":"")"><i class="fa fa-home"></i> Bosh sahifa</a></li>
            }
            <li><a asp-area="User" asp-controller="Book" asp-action="Index" class="@(ctrl=="Book"?"active-link":"")"><i class="fa fa-search"></i> Katalog</a></li>

            @if (isAuth)
            {
                <li><a asp-area="User" asp-controller="Loan" asp-action="Index"><i class="fa fa-book"></i> @(isStaff ? "Beruvlar" : "Kitoblarim")</a></li>
                <li><a asp-area="User" asp-controller="Reservation" asp-action="Index"><i class="fa fa-calendar"></i> @(isStaff ? "Bronlar" : "Bronlarim")</a></li>
                <li><a asp-area="User" asp-controller="Fine" asp-action="Index"><i class="fa fa-exclamation-triangle"></i> Jarimalar</a></li>

                @if (!isStaff)
                {
                    <li><div class="mobile-divider">XIZMATLAR</div></li>
                    <li><a asp-area="User" asp-controller="Abonement" asp-action="Index"><i class="fa fa-star"></i> Abonement</a></li>
                    <li><a asp-area="User" asp-controller="Cart" asp-action="Index"><i class="fa fa-shopping-cart"></i> Savat@(cartCount>0 ? $" ({cartCount})" : "")</a></li>
                    <li><a asp-area="User" asp-controller="Purchase" asp-action="Index"><i class="fa fa-shopping-bag"></i> Xaridlarim</a></li>
                    <li><a asp-area="User" asp-controller="KutishRoyxati" asp-action="Index"><i class="fa fa-clock-o"></i> Kutish ro'yxati</a></li>
                    <li><a asp-area="User" asp-controller="YetkazibBerish" asp-action="Index"><i class="fa fa-truck"></i> Yetkazish</a></li>
                }
                @if (isStaff)
                {
                    <li><a asp-area="Admin" asp-controller="Home" asp-action="Index"><i class="fa fa-cog"></i> Admin panel</a></li>
                }
                <li><div class="mobile-divider">HISOB</div></li>
                <li><a asp-area="User" asp-controller="Profile" asp-action="Index"><i class="fa fa-user"></i> Profil</a></li>
                <li><a asp-area="User" asp-controller="Profile" asp-action="ChangePassword"><i class="fa fa-lock"></i> Parol o'zgartirish</a></li>
                <li>
                    <form asp-area="" asp-controller="Home" asp-action="Index" method="post" style="margin:0;">
                        <button type="submit" style="width:100%;padding:12px 20px;text-align:left;background:none;border:none;border-bottom:1px solid #eee;cursor:pointer;font-size:14px;color:#c0392b;display:flex;align-items:center;gap:10px;">
                            <i class="fa fa-sign-out" style="width:18px;"></i> Chiqish
                        </button>
                    </form>
                </li>
            }
            else
            {
                <li><div class="mobile-divider">HISOB</div></li>
                <li><a asp-area="" asp-controller="Account" asp-action="Login"><i class="fa fa-sign-in"></i> Kirish</a></li>
                <li><a asp-area="" asp-controller="Account" asp-action="Register"><i class="fa fa-user-plus"></i> Ro'yxatdan o'tish</a></li>
            }
        </ul>
    </div>
</div>

<!-- ═══ ASOSIY KONTENT ════════════════════════════════════ -->
<div class="main-content">
    @if (TempData["Success"] != null)
    {
        <div class="container" style="padding-top:12px; padding-bottom:0;">
            <div class="alert alert-success">@TempData["Success"]</div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="container" style="padding-top:12px; padding-bottom:0;">
            <div class="alert alert-danger">@TempData["Error"]</div>
        </div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="container" style="padding-top:12px; padding-bottom:0;">
            <div class="alert alert-warning">@TempData["Warning"]</div>
        </div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="container" style="padding-top:12px; padding-bottom:0;">
            <div class="alert alert-info">@TempData["Info"]</div>
        </div>
    }

    @RenderBody()
</div>

<!-- ═══ FOOTER ═══════════════════════════════════════════ -->
