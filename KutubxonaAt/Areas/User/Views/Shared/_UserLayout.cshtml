                    <ul style="list-style:none;padding:0;margin:0;">
                        <li style="margin-bottom:5px;"><a asp-area="User" asp-controller="Book" asp-action="Index" style="color:#aaa;font-size:13px;"><i class="fa fa-angle-right" style="margin-right:5px;"></i>Katalog</a></li>
                        @if (isAuth)
                        {
                            <li style="margin-bottom:5px;"><a asp-area="User" asp-controller="Profile" asp-action="Index" style="color:#aaa;font-size:13px;"><i class="fa fa-angle-right" style="margin-right:5px;"></i>Profil</a></li>
                            <li style="margin-bottom:5px;"><a asp-area="User" asp-controller="Loan" asp-action="Index" style="color:#aaa;font-size:13px;"><i class="fa fa-angle-right" style="margin-right:5px;"></i>Kitoblarim</a></li>
                            <li style="margin-bottom:5px;"><a asp-area="User" asp-controller="Fine" asp-action="Index" style="color:#aaa;font-size:13px;"><i class="fa fa-angle-right" style="margin-right:5px;"></i>Jarimalar</a></li>
                        }
                        else
                        {
                            <li style="margin-bottom:5px;"><a asp-area="" asp-controller="Account" asp-action="Login" style="color:#aaa;font-size:13px;"><i class="fa fa-angle-right" style="margin-right:5px;"></i>Kirish</a></li>
                            <li style="margin-bottom:5px;"><a asp-area="" asp-controller="Account" asp-action="Register" style="color:#aaa;font-size:13px;"><i class="fa fa-angle-right" style="margin-right:5px;"></i>Ro'yxatdan o'tish</a></li>
                        }
                    </ul>
                </div>
                <div class="col-md-2 col-sm-6" style="margin-bottom:20px;">
                    <h3 class="footer-widget-title">Ish vaqti</h3>
                    <span class="underline left"></span>
                    <ul style="list-style:none;padding:0;margin:0;font-size:13px;color:#aaa;">
                        <li style="margin-bottom:4px;">Du–Pa: 9:00 – 21:00</li>
                        <li style="margin-bottom:4px;">Juma: 9:00 – 18:00</li>
                        <li style="margin-bottom:4px;">Shanba: 9:00 – 17:00</li>
                        <li style="margin-bottom:4px;">Yakshanba: 13:00 – 18:00</li>
                    </ul>
                </div>
                <div class="col-md-4 col-sm-6" style="margin-bottom:20px;">
                    <h3 class="footer-widget-title">Tizim imkoniyatlari</h3>
                    <span class="underline left"></span>
                    <p style="color:#aaa;font-size:13px;line-height:1.7;">
                        Kitob bron qilish, ijaraga olish, online uzaytirish, jarimalar nazorati, abonement tizimi va kitob sotib olish — barchasi bir platformada.
                    </p>
                </div>
            </div>
        </div>
    </div>
    <div style="background:#111;padding:12px 0;text-align:center;font-size:12px;color:#666;border-top:1px solid #222;">
        © @DateTime.Now.Year Kutubxona AT. Barcha huquqlar himoyalangan.
    </div>
</footer>

<script src="~/js/jquery-1.12.4.min.js"></script>
<script src="~/js/bootstrap.min.js"></script>
<script src="~/js/main.js"></script>
<script>
    // ── Hamburger menyu ────────────────────────────────────
    (function () {
        var hamburger = document.getElementById('hamburgerBtn');
        var mobileMenu = document.getElementById('mobileMenu');
        if (!hamburger || !mobileMenu) return;

        hamburger.addEventListener('click', function () {
            this.classList.toggle('open');
            mobileMenu.classList.toggle('open');
            document.body.style.overflow = mobileMenu.classList.contains('open') ? 'hidden' : '';
        });

        mobileMenu.addEventListener('click', function (e) {
            if (e.target === this) {
                hamburger.classList.remove('open');
                this.classList.remove('open');
                document.body.style.overflow = '';
            }
        });
    })();

    // ── Dropdown klaviatura yopish ─────────────────────────
    document.addEventListener('click', function (e) {
        if (!e.target.closest('.lib-dropdown')) {
            document.querySelectorAll('.lib-dropdown.open').forEach(function (d) {
                d.classList.remove('open');
            });
        }
    });

    document.querySelectorAll('.lib-dropdown > a, .lib-user-btn').forEach(function (el) {
        el.addEventListener('click', function (e) {
            var parent = this.closest('.lib-dropdown');
            if (parent) {
                e.stopPropagation();
                parent.classList.toggle('open');
            }
        });
    });

    // ── Like tugmasi ───────────────────────────────────────
    document.querySelectorAll('.like-btn').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
            e.preventDefault();
            var isLoggedIn = @(isAuth ? "true" : "false");
            if (!isLoggedIn) {
                window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
                return;
            }
            this.classList.toggle('liked');
        });
    });

    // ── Global yordamchi funksiyalar ───────────────────────
    function requireLogin(returnUrl) {
        var isLoggedIn = @(isAuth ? "true" : "false");
        if (!isLoggedIn) {
            window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent(returnUrl || window.location.pathname);
            return false;
        }
        return true;
    }

    function libPrint() {
        if (requireLogin()) window.print();
    }

    function libShare(title, url) {
        if (!requireLogin()) return;
        if (navigator.share) {
            navigator.share({ title: title, url: url }).catch(console.error);
        } else {
            try {
                navigator.clipboard.writeText(url).then(function() { alert('Havola nusxalandi!'); });
            } catch(e) { alert('Havola: ' + url); }
        }
    }
</script>
@RenderSection("Scripts", required: false)
</body>
</html>
