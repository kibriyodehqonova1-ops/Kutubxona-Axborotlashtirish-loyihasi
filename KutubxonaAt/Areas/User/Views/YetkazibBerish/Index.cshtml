@model IEnumerable<KutubxonaAt.Models.YetkazibBerish>
@{
    ViewData["Title"] = "Yetkazib berishlar";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
}

<section class="page-banner services-banner">
    <div class="container">
        <div class="banner-header">
            <h2>Yetkazib berishlarim</h2>
            <span class="underline center"></span>
        </div>
        <div class="breadcrumb">
            <ul>
                <li><a asp-area="User" asp-controller="Home" asp-action="Index">Bosh sahifa</a></li>
                <li>Yetkazib berishlar</li>
            </ul>
        </div>
    </div>
</section>

<div id="content" class="site-content">
    <div class="container" style="padding: 30px 15px;">

        @if (TempData["Xabar"] != null)
        {
            <div class="alert alert-@(TempData["XabarTuri"] ?? "info") alert-dismissible">
                <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                @TempData["Xabar"]
            </div>
        }

        @if (!Model.Any())
        {
            <div class="text-center" style="padding:60px 0;">
                <i class="fa fa-truck fa-4x text-muted"></i>
                <h3 class="text-muted" style="margin-top:20px;">Yetkazib berish buyurtmalari yo'q</h3>
                <a asp-area="User" asp-controller="Loan" asp-action="Index" class="btn btn-primary">
                    Kitoblarimni ko'rish
                </a>
            </div>
        }
        else
        {
            <div class="panel panel-default">
                <div class="panel-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Kuzatuv</th>
                                    <th>Kitob</th>
                                    <th>Manzil</th>
                                    <th>Narx</th>
                                    <th>Buyurtma sanasi</th>
                                    <th>Taxminiy yetkazish</th>
                                    <th>Holat</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var y in Model)
                                {
                                    var kitobNomi = y.Beruv?.KitobNusxa?.Kitob?.Nomi
                                        ?? y.Bron?.Kitob?.Nomi ?? "—";
                                    var holatRang = y.Holati switch
                                    {
                                        "Tayyorlanmoqda" => "warning",
                                        "Yo'lda" => "info",
                                        "Yetkazildi" => "success",
                                        _ => "default"
                                    };
                                    <tr>
                                        <td><code>#@y.KuzatuvRaqami</code></td>
                                        <td>@kitobNomi</td>
                                        <td><small>@y.Manzil</small></td>
                                        <td>@(y.YetkazishNarxi == 0 ? "Bepul" : y.YetkazishNarxi.ToString("N0") + " so'm")</td>
                                        <td>@y.BuyurtmaSana.ToString("dd.MM.yyyy")</td>
                                        <td>@(y.YetkazilishKutilganSana?.ToString("dd.MM.yyyy") ?? "—")</td>
                                        <td>
                                            <span class="label label-@holatRang">
                                                @if (y.Holati == "Yo'lda") { <i class="fa fa-truck"></i> }
                                                @if (y.Holati == "Yetkazildi") { <i class="fa fa-check"></i> }
                                                @y.Holati
                                            </span>
                                        </td>
                                        <td>
                                            <a asp-action="Kuzatish" asp-route-id="@y.Id"
                                               class="btn btn-xs btn-info">Kuzatish</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
