@model KutubxonaAt.Models.YetkazibBerish
@{
    ViewData["Title"] = "Yetkazib berish buyurtmasi";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    var bepulYetkazish = (bool)(ViewBag.BepulYetkazish ?? false);
    var yetkazishNarxi = (decimal)(ViewBag.YetkazishNarxi ?? 5000m);
}

<section class="page-banner services-banner">
    <div class="container">
        <div class="banner-header">
            <h2>Yetkazib berish</h2>
            <span class="underline center"></span>
        </div>
    </div>
</section>

<div id="content" class="site-content">
    <div class="container" style="padding:30px 15px;">
        <div class="row">
            <div class="col-md-8 col-md-offset-2">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h3 class="panel-title"><i class="fa fa-truck"></i> Yetkazib berish ma'lumotlari</h3>
                    </div>
                    <div class="panel-body">

                        @if (bepulYetkazish)
                        {
                            <div class="alert alert-success">
                                <i class="fa fa-gift"></i>
                                <strong>Tabriklaymiz!</strong> Abonementingiz orqali yetkazib berish <strong>bepul</strong>.
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <i class="fa fa-info-circle"></i>
                                Yetkazib berish narxi: <strong>@yetkazishNarxi.ToString("N0") so'm</strong>.
                                Bepul yetkazish uchun abonement oling.
                            </div>
                        }

                        <form asp-action="Buyurtma" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="BeruvId" value="@ViewBag.BeruvId" />
                            <input type="hidden" name="BronId" value="@ViewBag.BronId" />
                            <input type="hidden" name="YetkazishNarxi" value="@yetkazishNarxi" />

                            <div class="form-group">
                                <label>Yetkazish manzili <span class="text-danger">*</span></label>
                                <input name="Manzil" class="form-control"
                                       value="@ViewBag.DefaultManzil"
                                       placeholder="To'liq manzil: ko'cha, uy raqami, xonadon" required />
                            </div>

                            <div class="form-group">
                                <label>Shahar</label>
                                <input name="Shahar" class="form-control" placeholder="Toshkent" />
                            </div>

                            <div class="form-group">
                                <label>Telefon raqam <span class="text-danger">*</span></label>
                                <input name="TelefонRaqam" class="form-control"
                                       value="@ViewBag.DefaultTelefon"
                                       placeholder="+998 90 123 45 67" required />
                            </div>

                            <div class="form-group">
                                <label>Izoh (ixtiyoriy)</label>
                                <textarea name="Izoh" class="form-control" rows="2"
                                          placeholder="Qo'shimcha ma'lumot..."></textarea>
                            </div>

                            <div class="well well-sm">
                                <strong>Jami to'lov:</strong>
                                @(bepulYetkazish ? "Bepul" : yetkazishNarxi.ToString("N0") + " so'm")
                            </div>

                            <button type="submit" class="btn btn-primary btn-block">
                                <i class="fa fa-truck"></i> Buyurtma berish
                            </button>
                            <a asp-action="Index" class="btn btn-default btn-block" style="margin-top:10px;">
                                Bekor qilish
                            </a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
