
@using KutubxonaAt.ViewModels.Account
@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Parolni o‘zgartirish";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
}

<!-- Page Banner -->
<section class="page-banner services-banner">
    <div class="container">
        <div class="banner-header">
            <h2>Parolni o‘zgartirish</h2>
            <span class="underline center"></span>
            <p class="lead">Hisobingiz parolini yangilash</p>
        </div>
        <div class="breadcrumb">
            <ul>
                <li><a asp-area="User" asp-controller="Home" asp-action="Index">Bosh sahifa</a></li>
                <li>Parolni o‘zgartirish</li>
            </ul>
        </div>
    </div>
</section>

<div id="content" class="site-content">
    <div id="primary" class="content-area">
        <main id="main" class="site-main">
            <div class="main-news-list">
                <div class="container">
                    <div class="row">
                        <div class="col-md-6 col-md-offset-3">
                            <div class="panel panel-default">
                                <div class="panel-heading">
                                    <h3 class="panel-title">Parolni o‘zgartirish</h3>
                                </div>
                                <div class="panel-body">
                                    <form asp-action="ChangePassword" method="post">
                                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                        <div class="form-group">
                                            <label asp-for="OldPassword">Eski parol</label>
                                            <input asp-for="OldPassword" class="form-control" type="password" />
                                            <span asp-validation-for="OldPassword" class="text-danger"></span>
                                        </div>
                                        <div class="form-group">
                                            <label asp-for="NewPassword">Yangi parol</label>
                                            <input asp-for="NewPassword" class="form-control" type="password" />
                                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                                        </div>
                                        <div class="form-group">
                                            <label asp-for="ConfirmPassword">Yangi parolni tasdiqlang</label>
                                            <input asp-for="ConfirmPassword" class="form-control" type="password" />
                                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                                        </div>
                                        <button type="submit" class="btn btn-primary">O‘zgartirish</button>
                                        <a asp-action="Index" class="btn btn-default">Bekor qilish</a>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
```